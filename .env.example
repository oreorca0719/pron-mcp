# Microsoft Entra ID (Azure AD) 앱 등록 정보
# portal.azure.com → Microsoft Entra ID → 앱 등록 → 새 등록 후 받은 값들

# 회사(테넌트) ID — Entra ID 개요 페이지의 "디렉터리(테넌트) ID"
AZURE_TENANT_ID=<YOUR_TENANT_ID>

# Entra ID 앱 등록 시 발급되는 애플리케이션(클라이언트) ID
# 등록 절차: portal.azure.com → 앱 등록 → 새 등록 →
#   이름: pron-mcp (또는 원하는 이름)
#   지원 계정 유형: 이 조직 디렉터리의 계정만 (단일 테넌트)
#   리디렉션 URI: (비워두기 - public client는 불필요)
#   등록 후 "퍼블릭 클라이언트 흐름 허용" → 예
#   API 권한 → Microsoft Graph → 위임된 권한 추가:
#     Mail.Send, Mail.ReadWrite, Mail.Read, offline_access, User.Read
AZURE_CLIENT_ID=<YOUR_CLIENT_ID>

# 토큰 캐시 파일 경로 (기본값: 사용자 홈 디렉토리의 ~/.pron-mcp/token_cache.bin)
# 보안: 사용자만 읽기 권한(0600)으로 자동 설정됨
# TOKEN_CACHE_PATH=~/.pron-mcp/token_cache.bin

# 로그 레벨 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# MCP 서버 실행 모드
# sse: 사내 서버 배포 시 (기본값)
# stdio: 로컬 단독 실행 시
MCP_TRANSPORT=sse
MCP_HOST=0.0.0.0
MCP_PORT=8000

# 후이즈메일 계정 (사용자 PC별로 개인 계정 설정)
# 서버 .env에는 입력하지 말 것 → SSE 연결 시 X-Whois-Email / X-Whois-Password
# 헤더로 사용자별로 전달한다 (server.py 참고).
# WHOIS_EMAIL=your-name@your-company.example
# WHOIS_PASSWORD=your_password
